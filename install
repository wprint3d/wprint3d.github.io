#!/usr/bin/env bash

set -euo pipefail

TARGET_PATH="${HOME}/.wprint3d"

log() {
    printf '%s\n' "$*"
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

docker_is_podman_wrapper() {
    local version_output

    version_output="$(docker --version 2>/dev/null || true)"

    [[ "${version_output,,}" == *podman* ]]
}

ensure_docker() {
    if ! has_command docker || ! docker --version >/dev/null 2>&1; then
        log "Docker is not installed. Please install Docker Engine and try again."

        exit 1
    fi

    if docker_is_podman_wrapper; then
        log "The 'docker' command on this host is still the Podman compatibility wrapper."
        log "Remove podman-docker/the local Docker wrapper and install Docker Engine, then run this installer again."

        exit 1
    fi

    if docker compose version >/dev/null 2>&1; then
        return 0
    fi

    if has_command docker-compose && docker-compose version >/dev/null 2>&1; then
        return 0
    fi

    log "Docker Compose is not available to the Docker CLI. Install the Docker Compose plugin or docker-compose, then try again."

    exit 1
}

detect_default_branch() {
    curl -sfL \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        https://api.github.com/repos/wprint3d/wprint3d-core \
        | sed -n 's/.*"default_branch"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

download_core_file() {
    local default_branch="$1"
    local source_path="$2"
    local destination_path="$3"
    local temp_file

    temp_file="$(mktemp --suffix=-wprint3d-download)"

    curl -sfL "https://raw.githubusercontent.com/wprint3d/wprint3d-core/refs/heads/${default_branch}/${source_path}" > "$temp_file"

    if [[ ! -s "$temp_file" ]]; then
        log "Failed to download ${source_path}."

        exit 1
    fi

    mkdir -p "$(dirname "$destination_path")"
    chmod +x "$temp_file"
    mv -fv "$temp_file" "$destination_path"
}

download_runner() {
    local default_branch

    default_branch="$(detect_default_branch)"

    if [[ -z "$default_branch" ]]; then
        log "Failed to detect the default branch for wprint3d-core."

        exit 1
    fi

    download_core_file "$default_branch" run.sh wprint3d-run.sh
    download_core_file "$default_branch" internal/migrate-podman-mongo-volume-to-docker.sh internal/migrate-podman-mongo-volume-to-docker.sh
}

main() {
    ensure_docker

    mkdir -p "$TARGET_PATH"
    cd "$TARGET_PATH"

    log "Installing WPrint 3D..."
    download_runner

    LC_ALL=C LANG=C bash wprint3d-run.sh
}

main "$@"
