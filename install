#!/usr/bin/env bash

set -euo pipefail

TARGET_PATH="${HOME}/.wprint3d"

log() {
    printf '%s
' "$*"
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

ensure_docker() {
    if ! has_command docker || ! docker --version >/dev/null 2>&1; then
        log "Docker is not installed. Please install Docker and try again."

        exit 1
    fi

    if ! docker compose version >/dev/null 2>&1; then
        log "Docker Compose is not available. Please install the Docker Compose plugin and try again."

        exit 1
    fi
}

download_runner() {
    local temp_file
    local default_branch

    temp_file="$(mktemp --suffix=-wprint3d-runner)"

    default_branch="$(
        curl -sfL             -H "Accept: application/vnd.github+json"             -H "X-GitHub-Api-Version: 2022-11-28"             https://api.github.com/repos/wprint3d/wprint3d-core             | sed -n 's/.*"default_branch"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
    )"

    if [[ -z "$default_branch" ]]; then
        log "Failed to detect the default branch for wprint3d-core."

        exit 1
    fi

    curl -sfL "https://raw.githubusercontent.com/wprint3d/wprint3d-core/refs/heads/${default_branch}/run.sh" > "$temp_file"

    if [[ ! -s "$temp_file" ]]; then
        log "Failed to download the WPrint 3D runner."

        exit 1
    fi

    chmod +x "$temp_file"
    mv -fv "$temp_file" wprint3d-run.sh
}

main() {
    ensure_docker

    mkdir -p "$TARGET_PATH"
    cd "$TARGET_PATH"

    log "Installing WPrint 3D..."
    download_runner

    LC_ALL=C LANG=C bash wprint3d-run.sh
}

main "$@"
